# Copia este archivo como .env y reemplaza los valores por los reales.
# Nunca comitees .env con valores reales — este archivo (.env.example) es el único que debe subirse a git.

# Postgres (usado por docker-compose.yml)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="reemplaza-con-una-contraseña-segura"
POSTGRES_DB="jacana-dev"

# Debe coincidir con los valores de POSTGRES_* de arriba
DATABASE_URL="postgresql://postgres:reemplaza-con-una-contraseña-segura@localhost:5432/jacana-dev"

JWT_SECRET="reemplaza-con-un-secreto-largo-y-aleatorio"
AUTH_SECRET="reemplaza-con-un-secreto-largo-y-aleatorio"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
RESEND_API_KEY=""
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
